{
  "manifest_version": 3,
  "name": "Non Inventory · SPA1",
  "version": "1.0.0",
  "description": "One barcode, local missing-item investigation and authorized APEX monthly audit.",
  "browser_specific_settings": {"gecko": {"id": "non-inventory@builtbysai.com", "strict_min_version": "128.0"}},
  "permissions": ["activeTab", "tabs", "storage", "scripting", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_title": "Non Inventory · SPA1", "default_popup": "popup.html"}
}
