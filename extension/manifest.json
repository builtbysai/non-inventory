{
  "manifest_version": 2,
  "name": "Non-Inventory",
  "version": "2.0.0",
  "description": "One barcode, local missing-item investigation and authorized APEX monthly audit.",
  "browser_specific_settings": {
    "gecko": {
      "id": "non-inventory@builtbysai.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "optional_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "browser_action": {
    "default_title": "Non Inventory \u00b7 SPA1",
    "default_popup": "popup.html"
  }
}
